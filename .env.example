# Copy to .env at the repo root (same level as docker-compose.yml)
# and fill in real values. Never commit .env.
#
# IMPORTANT: the original repo had a committed .env.prod with real
# plaintext secrets. That file was NOT carried into this split.
# If it was ever pushed to a remote (even a private one), rotate the
# DB password, NEXTAUTH_SECRET, and CRON_SECRET immediately — treat
# them as compromised.

# --- Postgres ---
POSTGRES_USER=dopamine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dopamine_site

# --- Backend auth ---
# generate with: openssl rand -base64 32
AUTH_SECRET=change-me
CRON_SECRET=generate-a-random-string

# Comma-separated, exact origins only (no wildcards) — the frontend's
# public origin(s) that are allowed to call the backend with cookies.
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# --- Worker ---
TRACKING_INTERVAL_MS=60000

# --- Frontend ---
# Baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# --- MinIO (self-hosted S3-compatible object storage) ---
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dopamine-minio-admin
S3_SECRET_ACCESS_KEY=change-me-strong-password
S3_BUCKET=dopamine-site-media
S3_PUBLIC_URL=https://media.yourdomain.com
