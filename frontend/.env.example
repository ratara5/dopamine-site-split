# Copy to .env.local (dev) or .env (prod build) and fill in real values.

# Public backend origin — used by the BROWSER (login, checkout, order
# tracking polling). Must be the real public HTTPS domain: it's baked
# into the client bundle at build time (NEXT_PUBLIC_* vars are, by
# Next.js design, not secret and not runtime-configurable after build).
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# Backend origin used by SERVER COMPONENTS (home/provider/product
# pages) at request time. In docker-compose this is the backend
# container's internal hostname — faster than round-tripping through
# the public internet/Caddy for server-to-server calls. Falls back to
# NEXT_PUBLIC_API_URL if unset.
INTERNAL_API_URL="http://backend:3001"

# Local dev without Docker: both can point at the same place, e.g.
# NEXT_PUBLIC_API_URL="http://localhost:3001"
# INTERNAL_API_URL="http://localhost:3001"
# NOTE: the backend sets its session cookie with `Secure`, which
# browsers refuse to store over plain http://. For local login/checkout
# testing you'll need either an HTTPS local setup (e.g. mkcert +
# a local Caddy/nginx) or a temporary dev-only relaxation of the
# cookie's Secure flag on the backend — see MIGRATION_NOTES.md.
