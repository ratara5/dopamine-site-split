# Copy to .env and fill in real values. Never commit .env.
# NOTE: the original repo's .env.prod had real plaintext secrets
# (DB password, NEXTAUTH_SECRET, CRON_SECRET) checked in. Those were
# NOT carried over into this split — rotate them immediately if this
# repo (or its git history) has ever been pushed anywhere.

# Postgres connection string. Self-hosted Postgres on the same VPS
# (see docker-compose.yml) — no Supabase/Neon needed.
DATABASE_URL="postgresql://user:password@postgres:5432/dopamine_site"

# JWT signing secret for session tokens (replaces NEXTAUTH_SECRET).
# generate with: openssl rand -base64 32
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Comma-separated allowlist of origins allowed to call this API with
# credentials. Must be exact origins (scheme + host + port), no
# wildcards — required because cookies are sent with
# credentials: "include".
CORS_ALLOWED_ORIGINS="https://app.yourdomain.com,http://localhost:3000"

# Protects POST /internal/simulate-tracking from public calls.
CRON_SECRET="generate-a-random-string"

# How often the standalone worker advances active orders, in ms.
TRACKING_INTERVAL_MS=60000

PORT=3001

# MinIO (self-hosted S3-compatible object storage) — provisioned for
# upcoming features (dynamic uploads); nothing in the ported v1 routes
# uses this yet, since today's provider/product images are static
# seeded URLs under /public/parody-assets.
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="dopamine-minio-admin"
S3_SECRET_ACCESS_KEY="generate-a-strong-password"
S3_BUCKET="dopamine-site-media"
# Public URL for serving objects through Caddy (see caddy/Caddyfile)
S3_PUBLIC_URL="https://media.yourdomain.com"
