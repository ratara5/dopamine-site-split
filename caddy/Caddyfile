# Replace the domains below with your real ones. Caddy handles the
# Let's Encrypt certificate issuance and renewal automatically for all
# three — no certbot, no manual cert management.
#
# app.yourdomain.com and api.yourdomain.com are DELIBERATELY separate
# domains (not subdomains sharing a registrable parent with a shared
# cookie Domain), per the cross-origin auth design: the backend's
# session cookie is Secure; SameSite=None and CORS_ALLOWED_ORIGINS on
# the backend must list this exact frontend origin.

app.yourdomain.com {
  reverse_proxy frontend:3000
}

api.yourdomain.com {
  reverse_proxy backend:3001
}

# Public read-only media (MinIO). Only GET/HEAD on existing objects
# works here — the anonymous "download" bucket policy set by
# minio-init does not allow uploads or listing from the public
# internet; uploads still go through the backend using the MinIO
# credentials it holds server-side.
media.yourdomain.com {
  reverse_proxy minio:9000
}

# Optional: redirect www -> apex, or add a staging subdomain block
# here the same way if you want a separate preview environment.
